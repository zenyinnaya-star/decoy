{
  "name": "decoy",
  "version": "1.0.0",
  "description": "Browser extension: fills forms with fake data and scores a page for scam signals.",
  "main": "background.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lists": "node scripts/build-lists.mjs",
    "test": "node --test test/*.test.js",
    "test:backend": "node --test backend/test/app.test.js",
    "sweep": "node scripts/fp-sweep.mjs",
    "e2e": "npm run build && node test/e2e/dummy.e2e.cjs",
    "testbed": "node testbed/server.mjs",
    "e2e:testbed": "npm run build && node test/e2e/testbed.e2e.cjs",
    "e2e:guard": "npm run build && node test/e2e/guard.e2e.cjs",
    "e2e:protect": "DECOY_TEST=1 npm run build && node test/e2e/protect.e2e.cjs",
    "e2e:download": "DECOY_TEST=1 npm run build && node test/e2e/download.e2e.cjs",
    "e2e:cloud": "npm run build && node test/e2e/cloud.e2e.cjs",
    "e2e:perf": "DECOY_TEST=1 npm run build && node test/e2e/perf.e2e.cjs",
    "crawl": "node scripts/crawl.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "punycode": "^2.3.1",
    "tldts": "^7.4.19"
  },
  "type": "module"
}